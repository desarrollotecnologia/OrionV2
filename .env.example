# Configuracion ORION - copia este archivo como .env y ajusta los valores

# --- Servidor Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- Base de datos MySQL (usuario dedicado con contrasena; ver database/setup_mysql.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=orion_admin
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=orion

# --- Excel ORION ---
EXCEL_PATH=c:\Users\TIC\orionv2\ORION.xlsx

# --- Watcher en vivo ---
WATCHER_ENABLED=True
WATCHER_DEBOUNCE_SEC=2.0

# --- Login por defecto (creado al primer arranque si no existe) ---
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin
