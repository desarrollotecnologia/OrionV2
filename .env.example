# Configuracion Cut Beef - copia este archivo como .env y ajusta los valores

# --- Servidor Flask ---
FLASK_HOST=192.168.20.205
FLASK_PORT=8004
FLASK_DEBUG=False
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# --- MySQL (usuario MySQL, NO el login web de Cut Beef) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=Adm2026
DB_NAME=orion

# --- Excel ORION ---
EXCEL_PATH=C:\Users\serversoft\Documents\OrionV2\ORION.xlsx
# False = arranque rapido leyendo MySQL (recomendado en servidor)
IMPORT_ON_START=False

# --- Watcher en vivo ---
# False en servidor: actualiza con el boton "Sincronizar Excel" o setup_db.bat
WATCHER_ENABLED=False
WATCHER_DEBOUNCE_SEC=2.0

# --- URLs publicas ---
APP_PUBLIC_URL=http://192.168.20.205:8004/
SITE_PORTAL_URL=http://192.168.20.205:8000/site.html

# --- Login inicial (creado al primer arranque si no existe) ---
DEFAULT_ADMIN_USER=coordinacion.desposte@colbeef.com
DEFAULT_ADMIN_PASSWORD=Colbeef2026*
DEFAULT_RESET_PASSWORD=Colbeef2026*

# --- Bot de correo (SMTP Colbeef — mismas variables que otros proyectos) ---
# Servidor (MAIL_SERVER o MAIL_HOST)
MAIL_SERVER=mail.colbeef.com.co
MAIL_HOST=mail.colbeef.com.co
# Puerto 465 = SSL (SMTPS). 587 = STARTTLS (MAIL_USE_TLS=true, MAIL_USE_SSL=false)
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
# Cuenta emisora
MAIL_USERNAME=no-responder-sirt@colbeef.com.co
MAIL_PASSWORD=CAMBIA_ESTA_CONTRASENA
MAIL_DEFAULT_SENDER=no-responder-sirt@colbeef.com.co
MAIL_FROM=no-responder-sirt@colbeef.com.co
MAIL_FROM_NAME=Cut Beef
# Certificado autofirmado: descomenta si falla SSL
# MAIL_SSL_VERIFY=false
# MAIL_TIMEOUT=25
